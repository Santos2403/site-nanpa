# ============================================================
# NANPA Tecnologia — .htaccess (Apache / Hostinger Shared)
# ============================================================

Options -Indexes -ExecCGI -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# ---- HTTPS + domínio canônico (sem www) --------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.nanpatec\.com\.br$ [NC]
RewriteRule ^ https://nanpatec.com.br%{REQUEST_URI} [L,R=301]

# ---- Proteger endpoints /api/ -------------------------------------------------
# Somente whatsapp.php e contato.php, e somente via POST.
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_URI} !^/api/(whatsapp|contato)\.php$
RewriteRule ^ - [F,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^api/(whatsapp|contato)\.php$ - [F,L]

RewriteCond %{HTTP_USER_AGENT} (curl|wget|python-requests|scrapy|libwww-perl|Go-http-client|java/) [NC]
RewriteRule ^api/ - [F,L]

# Pasta legada do Cloudflare Pages Functions: não é usada na Hostinger
RewriteRule ^functions/ - [F,L]

# ---- URLs amigáveis ---------------------------------------------------------
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# /pagina.html -> /pagina  (301 permanente)
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

# /pagina/ -> /pagina (quando existe pagina.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]

# /pagina -> serve pagina.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]

# ---- Security Headers -------------------------------------------------------
<IfModule mod_headers.c>
    # CSP: inclui Google reCAPTCHA, Google Tag Manager, GA4 e Google Ads
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://www.gstatic.com https://recaptcha.net https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com; frame-src https://www.google.com https://recaptcha.net https://www.googletagmanager.com https://td.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://pagead2.googlesyndication.com https://www.gstatic.com https://www.google.com https://www.google.com.br https://www.googletagmanager.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com; media-src 'self'; connect-src 'self' https://pagead2.googlesyndication.com https://www.google.com https://www.google.com.br https://recaptcha.net https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.doubleclick.net https://www.googleadservices.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always unset X-Powered-By
    Header always unset Server

    # Cache: CSS/JS são versionados (?v=), imagens e vídeos mudam raramente
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico|mp4|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "(whatsapp|contato)\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set X-Robots-Tag "noindex, nofollow"
        Header always set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ---- Compressão ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

# ---- Negar acesso a arquivos sensíveis --------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|json|toml|lock|gitignore|md|py|example)$">
    Require all denied
</FilesMatch>

# ---- Proteção contra request flooding simples (requer mod_evasive no host) --
