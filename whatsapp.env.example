; Arquivo de configuracao do endpoint WhatsApp — NANPA Tecnologia
; ---------------------------------------------------------------
; IMPORTANTE: Este arquivo deve ficar FORA do public_html / document root
; Caminho recomendado no Hostinger:
;   /home/u123456789/env/whatsapp.env
; (onde u123456789 e seu usuario Hostinger)
;
; O arquivo whatsapp.php busca automaticamente em:
;   dirname(__DIR__, 2) . '/env/whatsapp.env'
;
; Se o arquivo nao for encontrado, o PHP tenta as variaveis de ambiente
; do servidor (definidas via .user.ini ou painel do Hostinger).
;
; NUNCA coloque este arquivo dentro de public_html/
; NUNCA versione este arquivo (adicione ao .gitignore)
; ---------------------------------------------------------------

; Numero do WhatsApp SEM formatacao — apenas digitos (DDI + DDD + numero)
; Exemplo Brasil: 556199998888
WHATSAPP_NUMBER=5500000000000

; Secret Key do Cloudflare Turnstile (obtida no painel da Cloudflare)
; NUNCA use a site key aqui — apenas a SECRET key
TURNSTILE_SECRET_KEY=COLOQUE_A_SECRET_KEY_DO_TURNSTILE_AQUI

; Hostnames autorizados (separados por virgula, sem espacos)
; Use exatamente o hostname que aparece na barra do navegador
ALLOWED_HOSTNAMES=nanpatec.com.br,www.nanpatec.com.br